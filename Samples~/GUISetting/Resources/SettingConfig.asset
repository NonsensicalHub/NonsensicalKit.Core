      {\r\n          \"id\": \"look\",\r\n          \"label\": \"\u5916\u89C2\",\r\n         
      \"description\": \"\u6539\u5B8C\u540E\u70B9\u5E95\u90E8\u300C\u5E94\u7528\u300D\u3002\u4E2D\u95F4\u65B9\u5757\u4F1A\u9A6C\u4E0A\u53D8\u3002\",\r\n         
      \"items\": [\r\n            {\r\n              \"type\": \"info\",\r\n             
      \"key\": \"project.help\",\r\n              \"label\": \"\u600E\u4E48\u770B\u6548\u679C\",\r\n             
      \"description\": \"\u9634\u5F71\u8DDD\u79BB\u770B\u53F3\u4FA7\u7531\u8FD1\u5230\u8FDC\u7684\u65B9\u5757\u5F71\u5B50\u3002\u9634\u5F71\u8D28\u91CF\u770B\u8FD1\u5904\u5F71\u5B50\u786C\u8F6F\u3002LOD
