      },\r\n            {\r\n              \"key\": \"project.color\",\r\n             
      \"type\": \"enum\",\r\n              \"label\": \"\u65B9\u5757\u989C\u8272\",\r\n             
      \"description\": \"\u4E2D\u95F4\u65B9\u5757\u7684\u989C\u8272\",\r\n             
