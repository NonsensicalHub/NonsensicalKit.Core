  "description": "NonsensicalKit.Core为NonsensicalKit的核心包，此工具集的任意其他包都依赖于此包。\r\n此包包含项目简易框架、各种工具类。\n兼容2021.3到6000.0",
  "dependencies": {
    "com.cysharp.unitask": "2.5.5",
    "com.unity.cinemachine": "2.10.3",
    "com.unity.inputsystem": "1.7.0",
    "com.unity.nuget.newtonsoft-json": "3.2.1",
    "com.unity.render-pipelines.universal": "12.1.15",
